---
// The editor shell. It holds no content or secrets: everything it shows comes from
// /api/*, which requires the session cookie. Rendered by the Worker rather than
// prebuilt, because Cloudflare serves static files before the Worker runs, and the
// middleware must be able to hide this page on the public domain (see ADMIN_HOST).
import App from '../../admin/App';

export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Manta Editor</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <App client:only="preact" />
  </body>
</html>
