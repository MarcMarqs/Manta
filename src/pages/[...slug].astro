---
import Base from '../layouts/Base.astro';
import PageView from '../components/PageView.astro';
import { pages, projects, site } from '../lib/content';

// One route for the whole site: every public page in content/pages/ becomes a page.
// home.json is the root, work/dunes.json is /work/dunes, and so on. Private and
// drafted case studies are not here; see content.ts.
export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.path === '/' ? undefined : page.path.slice(1) },
    props: { page },
  }));
}

const { page } = Astro.props;
const project = page.project ? projects.find((p) => p.slug === page.project) : undefined;
const image = page.image || project?.cover || site.socialImage;
---

<Base title={page.title} description={page.description} path={page.path} image={image}>
  <PageView page={page} project={project} />
</Base>
