---
// Inline SVG chart — no library, no client JS. Bars for comparison, line for trend.
// A series is either typed out or computed from a formula across a range, so a chart
// built on a curve stays right when the curve changes.
import { evaluateFormula, rangeValues, type ChartRange } from '../lib/formula';

export interface ChartPoint {
  label: string;
  value: number;
  emphasis?: 'accent' | 'muted';
}

export interface ChartSeries {
  name?: string;
  /** Expression in `x`, e.g. "round(90 * pow(1.28, x - 75))". Needs `range`. */
  formula?: string;
  labels?: boolean;
  data?: ChartPoint[];
}

interface Props {
  variant: 'bar' | 'line';
  /** Bars only: across the page, or down it with the categories on the left. */
  direction?: 'vertical' | 'horizontal';
  title?: string;
  note?: string;
  range?: ChartRange;
  reference?: { value: number; label?: string };
  series: ChartSeries[];
}

const { variant, direction, title, note, range, reference, series } = Astro.props;

let problem: string | null = null;

/** A formula series is computed here; a typed one is used as it stands. */
const resolve = (s: ChartSeries): ChartPoint[] => {
  if (!s.formula) return s.data ?? [];
  if (!range) {
    problem = 'This series has a formula but no range to run it over.';
    return [];
  }
  try {
    return rangeValues(range).map((x) => ({ label: String(x), value: evaluateFormula(s.formula!, x) }));
  } catch (err) {
    problem = `${s.name ? `${s.name}: ` : ''}${(err as Error).message}`;
    return [];
  }
};

/**
 * The emphasis a whole series carries, if every point in it carries the same one.
 *
 * Emphasis overrides the colour a series is drawn in, so a series whose points are all
 * stepped back is grey however its legend is coloured. The legend has to say what the
 * marks actually look like, or it is pointing at the wrong bars.
 */
const sharedEmphasis = (points: ChartPoint[]) => {
  const first = points[0]?.emphasis;
  return points.length > 0 && points.every((d) => d.emphasis === first) ? first : undefined;
};

const plots = series.map((s) => {
  const points = resolve(s);
  return { name: s.name, labels: s.labels, points, emphasis: sharedEmphasis(points) };
});
const labels = plots.reduce<string[]>((longest, p) => (p.points.length > longest.length ? p.points.map((d) => d.label) : longest), []);
const named = plots.filter((p) => p.name).length > 1;
const marksLabelled = plots.some((p) => p.labels) || plots.some((p) => p.points.some((d) => d.emphasis === 'accent'));

// Bars can run either way; a line always reads left to right, so it ignores this.
const horizontal = variant === 'bar' && direction === 'horizontal';

const W = 720;
const PAD = horizontal
  ? { top: named ? 34 : 16, right: 56, bottom: 34, left: 132 }
  : { top: (named ? 34 : 20) + (marksLabelled ? 14 : 0), right: 16, bottom: 40, left: 48 };

// Laid out across, the chart is as tall as it needs to be for its categories rather
// than a fixed height they have to squeeze into.
const band = Math.max(26, 16 * plots.length + 16);
const H = horizontal ? PAD.top + PAD.bottom + band * Math.max(labels.length, 1) : 300;
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const values = [...plots.flatMap((p) => p.points.map((d) => d.value)), ...(reference ? [reference.value] : [])];
const max = Math.max(...values, 0);
const min = Math.min(...values, 0);
const niceMax = max === 0 ? 1 : Math.ceil(max / 5) * 5;
const niceMin = min < 0 ? Math.floor(min / 5) * 5 : 0;
const span = niceMax - niceMin || 1;
const ticks = [niceMin, niceMin + span / 2, niceMax];

/** Where a value sits along the axis it is measured on. */
const v = (value: number) =>
  horizontal
    ? PAD.left + ((value - niceMin) / span) * plotW
    : PAD.top + plotH - ((value - niceMin) / span) * plotH;

const bandSize = horizontal ? plotH / Math.max(labels.length, 1) : plotW / Math.max(labels.length, 1);
/** The middle of a category's band, along the axis the categories are spread on. */
const c = (i: number) => (horizontal ? PAD.top : PAD.left) + bandSize * i + bandSize / 2;

// Bars of several series share a band, side by side inside it.
const thickness = Math.min((bandSize * 0.62) / Math.max(plots.length, 1), horizontal ? 40 : 72);
/** Where a series' bar starts within the band. */
const offset = (s: number) => -(thickness * plots.length) / 2 + s * thickness;

// Laid out down the page every category label has a line of its own; across it, with a
// long range, they would collide, so only some are drawn.
const labelEvery = horizontal ? 1 : Math.max(1, Math.ceil(labels.length / 12));

const linePath = (points: { value: number }[]) =>
  points.map((d, i) => `${i === 0 ? 'M' : 'L'}${c(i)},${v(d.value)}`).join(' ');
---

<figure class="chart">
  {title && <figcaption class="chart-title">{title}</figcaption>}
  {note && <p class="chart-note">{note}</p>}
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title ?? `${variant} chart`}>
    {
      named && (
        <g class="legend">
          {plots.map((p, s) => (
            <g transform={`translate(${PAD.left + s * 150}, 14)`}>
              <rect width="10" height="10" y="-9" rx="2" class={`swatch s${s}${p.emphasis ? ` is-${p.emphasis}` : ''}`} />
              <text x="16" class="axis">
                {p.name}
              </text>
            </g>
          ))}
        </g>
      )
    }
    {
      ticks.map((t) =>
        horizontal ? (
          <g>
            <line x1={v(t)} x2={v(t)} y1={PAD.top} y2={H - PAD.bottom} class="grid" />
            <text x={v(t)} y={H - PAD.bottom + 18} text-anchor="middle" class="axis">
              {Math.round(t)}
            </text>
          </g>
        ) : (
          <g>
            <line x1={PAD.left} x2={W - PAD.right} y1={v(t)} y2={v(t)} class="grid" />
            <text x={PAD.left - 10} y={v(t) + 4} text-anchor="end" class="axis">
              {Math.round(t)}
            </text>
          </g>
        ),
      )
    }
    {
      variant === 'bar'
        ? plots.map((p, s) =>
            p.points.map((d, i) =>
              horizontal ? (
                <g>
                  <rect
                    class={`bar s${s}${d.emphasis ? ` is-${d.emphasis}` : ''}`}
                    x={Math.min(v(d.value), v(0))}
                    y={c(i) + offset(s)}
                    width={Math.max(Math.abs(v(d.value) - v(0)), 1)}
                    height={Math.max(thickness - 1, 1)}
                  >
                    <title>{`${p.name ? `${p.name} · ` : ''}${d.label}: ${d.value}`}</title>
                  </rect>
                  {(p.labels || d.emphasis === 'accent') && (
                    <text
                      class={`mark-value${d.emphasis === 'accent' ? ' is-accent' : ''}`}
                      x={Math.max(v(d.value), v(0)) + 6}
                      y={c(i) + offset(s) + thickness / 2 + 4}
                    >
                      {d.value}
                    </text>
                  )}
                </g>
              ) : (
                <g>
                  <rect
                    class={`bar s${s}${d.emphasis ? ` is-${d.emphasis}` : ''}`}
                    x={c(i) + offset(s)}
                    y={Math.min(v(d.value), v(0))}
                    width={Math.max(thickness - 1, 1)}
                    height={Math.max(Math.abs(v(d.value) - v(0)), 1)}
                  >
                    <title>{`${p.name ? `${p.name} · ` : ''}${d.label}: ${d.value}`}</title>
                  </rect>
                  {(p.labels || d.emphasis === 'accent') && (
                    <text
                      class={`mark-value${d.emphasis === 'accent' ? ' is-accent' : ''}`}
                      x={c(i) + offset(s) + thickness / 2}
                      y={Math.min(v(d.value), v(0)) - 6}
                      text-anchor="middle"
                    >
                      {d.value}
                    </text>
                  )}
                </g>
              ),
            ),
          )
        : plots.map((p, s) => (
            <g>
              <path class={`line s${s}`} d={linePath(p.points)} />
              {p.points.map((d, i) => (
                <g>
                  <circle class={`dot s${s}${d.emphasis ? ` is-${d.emphasis}` : ''}`} cx={c(i)} cy={v(d.value)} r={d.emphasis === 'accent' ? 4.5 : 3}>
                    <title>{`${p.name ? `${p.name} · ` : ''}${d.label}: ${d.value}`}</title>
                  </circle>
                  {(p.labels || d.emphasis === 'accent') && (
                    <text
                      class={`mark-value${d.emphasis === 'accent' ? ' is-accent' : ''}`}
                      x={c(i)}
                      y={v(d.value) - 10}
                      text-anchor="middle"
                    >
                      {d.value}
                    </text>
                  )}
                </g>
              ))}
            </g>
          ))
    }

    {
      reference && (
        <g class="reference">
          {horizontal ? (
            <line x1={v(reference.value)} x2={v(reference.value)} y1={PAD.top} y2={H - PAD.bottom} />
          ) : (
            <line x1={PAD.left} x2={W - PAD.right} y1={v(reference.value)} y2={v(reference.value)} />
          )}
          {reference.label &&
            (horizontal ? (
              <text x={v(reference.value) + 6} y={PAD.top + 12} class="reference-label">
                {reference.label}
              </text>
            ) : (
              <text x={PAD.left + 6} y={v(reference.value) - 6} class="reference-label">
                {reference.label}
              </text>
            ))}
        </g>
      )
    }
    {
      labels.map((label, i) =>
        i % labelEvery !== 0 ? null : horizontal ? (
          <text x={PAD.left - 10} y={c(i) + 4} text-anchor="end" class="axis">
            {label}
          </text>
        ) : (
          <text x={c(i)} y={H - 14} text-anchor="middle" class="axis">
            {label}
          </text>
        ),
      )
    }
  </svg>
  {problem && <p class="chart-problem">Chart formula: {problem}</p>}
</figure>

<style>
  .chart {
    margin: 0;
  }

  .chart-title {
    font-family: var(--font-heading);
    font-weight: 600;
    margin-bottom: 8px;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid {
    stroke: var(--border);
    stroke-width: 1;
  }

  .axis {
    fill: var(--muted);
    font-size: 12px;
  }

  /* One accent, then colours that still read against it rather than competing. */
  .s0 {
    --plot: var(--accent);
  }
  .s1 {
    --plot: color-mix(in srgb, var(--accent) 35%, var(--fg));
  }
  .s2 {
    --plot: color-mix(in srgb, var(--accent) 30%, var(--muted));
  }

  .bar,
  .swatch {
    fill: var(--plot, var(--accent));
  }

  .line {
    fill: none;
    stroke: var(--plot, var(--accent));
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .dot {
    fill: var(--plot, var(--accent));
  }

  .chart-note {
    color: var(--muted);
    font-size: 0.85rem;
    margin: -4px 0 10px;
  }

  /* A line to read the bars against. It sits under the marks rather than over them,
     so it never hides the value it is there to compare with. */
  .reference line {
    stroke: var(--fg);
    stroke-width: 1.25;
    stroke-dasharray: 5 4;
    opacity: 0.55;
  }

  .reference-label {
    fill: var(--muted);
    font-size: 11.5px;
  }

  .mark-value {
    fill: var(--muted);
    font-size: 11.5px;
    font-family: var(--font-mono, inherit);
  }

  .mark-value.is-accent {
    fill: var(--fg);
    font-weight: 600;
  }

  /* Emphasis is relative: one point steps forward only because the others step back.
     The legend swatch takes it too when a whole series carries the same one, so what is
     in the key is the colour that is actually on the page. */
  .bar.is-muted,
  .dot.is-muted,
  .swatch.is-muted {
    fill: var(--muted);
    opacity: 0.45;
  }

  .bar.is-accent,
  .dot.is-accent,
  .swatch.is-accent {
    fill: var(--accent);
  }

  .chart-problem {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 6px;
  }
</style>
