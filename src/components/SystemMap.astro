---
/**
 * A system drawn as nodes and the links between them.
 *
 * Nothing here is positioned by hand. In `radial` the first node sits at the centre and
 * the rest are spaced evenly around it, which suits "one thing everything else feeds".
 * In `layered` nodes run left to right in the columns their `layer` names, which suits a
 * pipeline that fans out and back in. `stacked` turns that on its side: layers are rows
 * read down the page, and a row holding one node spans the whole width — a heading above
 * its pillars, a conclusion beneath them. A diagram needing real coordinates is a
 * drawing, and belongs in an image block.
 */
interface Props {
  arrange?: 'radial' | 'layered' | 'stacked';
  caption?: string;
  nodes: { id: string; label: string; note?: string; accent?: boolean; layer?: number }[];
  links: { from: string; to: string; label?: string; dashed?: boolean }[];
}

const { arrange = 'radial', caption, nodes, links } = Astro.props;

const CHAR = 6.6;
/** The note is 11px with a little tracking, so its characters are narrower. */
const NOTE_CHAR = 5.9;
const MAX_LINE = 18;
const LINE = 15;
const NOTE_LINE = 13;
/** Space inside a box, left and right, that no text may cross. */
const PAD_X = 24;
const PAD_Y = 15;
const NOTE_GAP = 5;

/** SVG text does not wrap, so every string is broken into lines before a box is sized. */
function wrap(text: string, max: number, maxLines: number): string[] {
  const lines: string[] = [];
  let line = '';
  for (const word of text.split(/\s+/)) {
    const next = line ? `${line} ${word}` : word;
    if (next.length > max && line) {
      lines.push(line);
      line = word;
    } else {
      line = next;
    }
  }
  if (line) lines.push(line);
  // Past the limit the rest is dropped rather than crammed onto the last line, which is
  // what used to push a long note out through the side of its box. A label has two lines
  // because it is a name; a note has as many as it was given.
  return lines.slice(0, maxLines);
}

interface NodeText {
  label: string[];
  note: string[];
  /** The note was written as a list, so it reads as one: markers, and ranged left. */
  bulleted: boolean;
}

const BULLET = /^[-*\u2022]\s+/;

/**
 * What fits in a box this wide.
 *
 * Both strings are wrapped to the box rather than measured into it: a note used to be
 * drawn as one unbroken line, so a sentence longer than the widest box simply ran out
 * of it and across the diagram.
 *
 * A note is written line by line. A line starting with a dash or a bullet makes the
 * whole note a list, which is ranged left and marked, because a centred list is not one.
 */
function textFor(n: { label: string; note?: string }, w: number): NodeText {
  const written = (n.note ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
  const bulleted = written.some((l) => BULLET.test(l));
  const room = Math.max(8, Math.floor((w - PAD_X) / NOTE_CHAR));
  const note = written.flatMap((l) => {
    const body = l.replace(BULLET, '');
    // A wrapped bullet keeps its following lines clear of the marker.
    const lines = wrap(body, bulleted ? room - 2 : room, 6);
    return lines.map((text, i) => (bulleted ? `${i === 0 ? '\u2022 ' : '  '}${text}` : text));
  });
  return { label: wrap(n.label, Math.max(6, Math.floor((w - PAD_X) / CHAR)), 2), note, bulleted };
}

const heightFor = (t: NodeText) =>
  PAD_Y * 2 + t.label.length * LINE + (t.note.length ? NOTE_GAP + t.note.length * NOTE_LINE : 0);

interface Placed extends NodeText {
  id: string;
  accent: boolean;
  x: number;
  y: number;
  w: number;
  h: number;
}

/** Where a box's text starts, so it sits in the middle however tall the box ended up. */
const textTop = (p: Placed) =>
  (p.h - (p.label.length * LINE + (p.note.length ? NOTE_GAP + p.note.length * NOTE_LINE : 0))) / 2;

// One width for every box, set by the longest label. A note never widens a box; it wraps
// inside it. Boxes of different widths in one diagram read as different kinds of thing,
// which is a claim the diagram is not making.
const widestLabel = Math.max(
  ...nodes.map((n) => wrap(n.label, MAX_LINE, 2).reduce((w, l) => Math.max(w, l.length), 0)),
  1,
);
const hasNote = nodes.some((n) => n.note);
const NODE_W = Math.min(Math.max(Math.round(widestLabel * CHAR) + 30, hasNote ? 168 : 112), 200);
const NODE_H = Math.max(...nodes.map((n) => heightFor(textFor(n, NODE_W))), 44);

const GAP_X = 76;
const GAP_Y = 26;
/** Rows need more air than columns, because the arrows between them run vertically. */
const ROW_GAP = 48;

/** Nodes grouped by the layer they name, in order. One without a layer falls into 0. */
const byLayer = () => {
  const layers = new Map<number, typeof nodes>();
  for (const n of nodes) {
    const l = n.layer ?? 0;
    layers.set(l, [...(layers.get(l) ?? []), n]);
  }
  return [...layers.keys()].sort((a, b) => a - b).map((k) => layers.get(k)!);
};

let placed: Placed[] = [];
let W = 0;
let H = 0;

if (arrange === 'radial' && nodes.length > 1) {
  // One hub, the rest on a ring around it. The radius grows with the number of
  // satellites so boxes never close up on each other.
  const petals = nodes.length - 1;
  const rx = Math.max(NODE_W * 1.7, (petals * (NODE_W + 26)) / (2 * Math.PI));
  const ry = Math.max(NODE_H * 2.8, (petals * (NODE_H + 40)) / (2 * Math.PI));
  W = Math.round(rx * 2 + NODE_W + 20);
  H = Math.round(ry * 2 + NODE_H + 20);
  const cx = W / 2;
  const cy = H / 2;
  placed = nodes.map((n, i) => {
    const text = textFor(n, NODE_W);
    if (i === 0)
      return { ...text, id: n.id, accent: n.accent ?? true, x: cx - NODE_W / 2, y: cy - NODE_H / 2, w: NODE_W, h: NODE_H };
    // Start at the top and go round clockwise, so reading order matches the markup.
    const angle = -Math.PI / 2 + ((i - 1) / petals) * Math.PI * 2;
    return {
      ...text,
      id: n.id,
      accent: n.accent ?? false,
      x: cx + Math.cos(angle) * rx - NODE_W / 2,
      y: cy + Math.sin(angle) * ry - NODE_H / 2,
      w: NODE_W,
      h: NODE_H,
    };
  });
} else if (arrange === 'stacked') {
  // Rows top to bottom, each one sharing the width between its boxes. A row holding a
  // single node becomes a band across the whole diagram, which is what a heading at the
  // top or a conclusion at the foot wants to be.
  const rows = byLayer();
  const columns = Math.max(...rows.map((r) => r.length), 1);
  W = columns * NODE_W + (columns - 1) * GAP_X;
  let y = 0;
  for (const row of rows) {
    const w = (W - (row.length - 1) * GAP_X) / row.length;
    const cells = row.map((n) => {
      const text = textFor(n, w);
      return { n, text, h: heightFor(text) };
    });
    // One height per row, so boxes meant to be read across sit on the same line.
    const rowH = Math.max(...cells.map((c) => c.h));
    cells.forEach((c, i) => {
      placed.push({ ...c.text, id: c.n.id, accent: c.n.accent ?? false, x: i * (w + GAP_X), y, w, h: rowH });
    });
    y += rowH + ROW_GAP;
  }
  H = Math.max(y - ROW_GAP, 0);
} else {
  // Columns left to right; a node without a layer falls into the first one.
  const columns = byLayer();
  const tallest = Math.max(...columns.map((c) => c.length), 1);
  W = columns.length * NODE_W + (columns.length - 1) * GAP_X;
  H = tallest * NODE_H + (tallest - 1) * GAP_Y;
  columns.forEach((column, ci) => {
    const span = column.length * NODE_H + (column.length - 1) * GAP_Y;
    column.forEach((n, ri) => {
      placed.push({
        ...textFor(n, NODE_W),
        id: n.id,
        accent: n.accent ?? false,
        x: ci * (NODE_W + GAP_X),
        y: (H - span) / 2 + ri * (NODE_H + GAP_Y),
        w: NODE_W,
        h: NODE_H,
      });
    });
  });
}

/** Stacked maps flow downward, so "back against the flow" means upward, not leftward. */
const vertical = arrange === 'stacked';

const at = new Map(placed.map((p) => [p.id, p]));

/**
 * Links are routed as right angles rather than curves.
 *
 * A bezier between two boxes has to guess a shape, and the guesses collide: two links
 * sharing a pair lie on top of each other, and a link running back against the flow
 * bulges through the gap the forward one is already using. Right angles have no shape
 * to guess. A link leaves an edge, runs to a lane, turns once, and arrives square on
 * the far edge, which also reads as the same kind of object as the boxes it joins.
 *
 * Three cases: across (the common one, turning at a lane between the columns), down
 * (within a column), and back (against the flow, which drops to a lane beneath every
 * box and comes up into the underside of its target). A radial map has no flow to run
 * against and no columns to turn between, so its links are straight lines.
 */
const pairSeen = new Map<string, number>();
const RETURN_DIP = 34;
const floorY = Math.max(...placed.map((p) => p.y + p.h), 0);
const rightX = Math.max(...placed.map((p) => p.x + p.w), 0);
const HEAD = 7;
let hasReturn = false;

/**
 * Two links going back from the same node would drop from the same point on its
 * underside and run down the same line before separating, which looks like one arrow
 * that forked. Counting them first lets each leave from its own place along the edge.
 */
const atFirst = new Map(placed.map((p) => [p.id, p]));
const returnsFrom = new Map<string, number>();
if (arrange !== 'radial') {
  for (const link of links) {
    const a = atFirst.get(link.from);
    const b = atFirst.get(link.to);
    if (!a || !b || a === b) continue;
    const back = vertical ? b.y + b.h / 2 < a.y + a.h / 2 - 1 : b.x + b.w / 2 < a.x + a.w / 2 - 1;
    if (back) returnsFrom.set(link.from, (returnsFrom.get(link.from) ?? 0) + 1);
  }
}
const returnSeen = new Map<string, number>();

const drawn = links
  .map((link) => {
    const a = at.get(link.from);
    const b = at.get(link.to);
    if (!a || !b || a === b) return null;
    const ac = { x: a.x + a.w / 2, y: a.y + a.h / 2 };
    const bc = { x: b.x + b.w / 2, y: b.y + b.h / 2 };

    // Links joining the same pair are nudged apart so each keeps its own line.
    const key = [link.from, link.to].sort().join('|');
    const nth = pairSeen.get(key) ?? 0;
    pairSeen.set(key, nth + 1);
    const nudge = nth * 12;

    if (arrange === 'radial') {
      const dx = bc.x - ac.x;
      const dy = bc.y - ac.y;
      const len = Math.hypot(dx, dy) || 1;
      const stop = { x: bc.x - (dx / len) * (b.w / 2 + HEAD), y: bc.y - (dy / len) * (b.h / 2 + HEAD) };
      return {
        path: `M${ac.x},${ac.y} L${stop.x},${stop.y}`,
        label: link.label,
        dashed: link.dashed,
        mid: { x: (ac.x + stop.x) / 2, y: (ac.y + stop.y) / 2 },
      };
    }

    // Back against the flow: out of the box, along a lane clear of everything, and in
    // again from the far side. Which side depends on which way the diagram runs.
    if (vertical ? bc.y < ac.y - 1 : bc.x < ac.x - 1) {
      hasReturn = true;
      const total = returnsFrom.get(link.from) ?? 1;
      const seen = returnSeen.get(link.from) ?? 0;
      returnSeen.set(link.from, seen + 1);
      const lane = (vertical ? rightX : floorY) + RETURN_DIP + seen * 14;
      if (vertical) {
        // Spread the exits evenly down the right edge rather than stacking them.
        const from = { x: a.x + a.w, y: a.y + (a.h * (seen + 1)) / (total + 1) };
        const to = { x: b.x + b.w + HEAD, y: bc.y };
        return {
          path: `M${from.x},${from.y} H${lane} V${to.y} H${to.x}`,
          label: link.label,
          dashed: link.dashed,
          mid: { x: lane - 5, y: (from.y + to.y) / 2 },
        };
      }
      // Spread the exits evenly along the underside rather than stacking them.
      const from = { x: a.x + (a.w * (seen + 1)) / (total + 1), y: a.y + a.h };
      const to = { x: bc.x, y: b.y + b.h + HEAD };
      return {
        path: `M${from.x},${from.y} V${lane} H${to.x} V${to.y}`,
        label: link.label,
        dashed: link.dashed,
        mid: { x: (from.x + to.x) / 2, y: lane - 5 },
      };
    }

    // A stacked map always runs down the page, however far apart two boxes sit sideways.
    const across = !vertical && Math.abs(bc.x - ac.x) >= Math.abs(bc.y - ac.y);

    if (across) {
      const from = { x: a.x + a.w, y: ac.y };
      const to = { x: b.x - HEAD, y: bc.y };
      // Straight when the two sit on the same line; otherwise one turn at a lane
      // halfway across the gap.
      const path =
        Math.abs(from.y - to.y) < 1
          ? `M${from.x},${from.y} H${to.x}`
          : `M${from.x},${from.y} H${(from.x + to.x) / 2 + nudge} V${to.y} H${to.x}`;
      return {
        path,
        label: link.label,
        dashed: link.dashed,
        mid: { x: (from.x + to.x) / 2 + nudge, y: (from.y + to.y) / 2 },
      };
    }

    const down = bc.y > ac.y;
    const from = { x: ac.x, y: down ? a.y + a.h : a.y };
    const to = { x: bc.x, y: down ? b.y - HEAD : b.y + b.h + HEAD };
    const path =
      Math.abs(from.x - to.x) < 1
        ? `M${from.x},${from.y} V${to.y}`
        : `M${from.x},${from.y} V${(from.y + to.y) / 2 + nudge} H${to.x} V${to.y}`;
    return {
      path,
      label: link.label,
      dashed: link.dashed,
      mid: { x: (from.x + to.x) / 2, y: (from.y + to.y) / 2 + nudge },
    };
  })
  .filter((d): d is NonNullable<typeof d> => d !== null);

const pad = 14;
/** A return arrow bows clear of the boxes, so the frame has to reach past it. */
const padBottom = pad + (hasReturn && !vertical ? RETURN_DIP + 18 : 0);
const padRight = pad + (hasReturn && vertical ? RETURN_DIP + 18 : 0);
const gridId = `grid-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="system-map">
  <div class="map-scroll">
    <svg
      viewBox={`${-pad} ${-pad} ${W + pad + padRight} ${H + pad + padBottom}`}
      style={`min-width:${Math.min(W + pad + padRight, 660)}px;max-width:${W + pad + padRight}px`}
      role="img"
      aria-label={caption ?? 'System diagram'}
    >
      <defs>
        <pattern id={gridId} width="22" height="22" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" class="grid-dot" />
        </pattern>
        <marker id="map-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" class="arrow-head" />
        </marker>
      </defs>
      <rect x={-pad} y={-pad} width={W + pad + padRight} height={H + pad + padBottom} fill={`url(#${gridId})`} />

      {drawn.map((d) => <path class={`link${d.dashed ? ' is-dashed' : ''}`} d={d.path} marker-end="url(#map-arrow)" />)}
      {
        drawn.map(
          (d) =>
            d.label && (
              <g transform={`translate(${d.mid.x}, ${d.mid.y})`}>
                <rect class="link-chip" x={-(d.label.length * 3.4 + 7)} y="-9" width={d.label.length * 6.8 + 14} height="18" rx="9" />
                <text class="link-label" x="0" y="4" text-anchor="middle">{d.label}</text>
              </g>
            ),
        )
      }
      {
        placed.map((p) => (
          <g transform={`translate(${p.x}, ${p.y})`}>
            <rect class={`map-node${p.accent ? ' is-accent' : ''}`} width={p.w} height={p.h} rx="12" />
            {p.label.map((line, i) => (
              <text class="map-label" x={p.w / 2} y={textTop(p) + LINE * (i + 1) - 4} text-anchor="middle">
                {line}
              </text>
            ))}
            {p.note.map((line, i) => (
              <text
                class="map-note"
                x={p.bulleted ? PAD_X / 2 : p.w / 2}
                y={textTop(p) + p.label.length * LINE + NOTE_GAP + NOTE_LINE * (i + 1) - 3}
                text-anchor={p.bulleted ? 'start' : 'middle'}
                xml:space="preserve"
              >
                {line}
              </text>
            ))}
          </g>
        ))
      }
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .system-map {
    margin: 0;
  }

  /* A map with several nodes is wider than a phone, so it scrolls sideways on its own
     rather than shrinking its labels past reading. */
  .map-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 10px;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  .grid-dot {
    fill: var(--border);
  }

  .map-node {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1;
  }

  .map-node.is-accent {
    fill: color-mix(in srgb, var(--accent) 14%, var(--bg));
    stroke: var(--accent);
  }

  .map-label {
    fill: var(--fg);
    font-size: 13px;
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .map-note {
    fill: var(--muted);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .link {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .link.is-dashed {
    stroke-dasharray: 5 4;
  }

  .arrow-head {
    fill: var(--border);
  }

  .link-chip {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1;
  }

  .link-label {
    fill: var(--muted);
    font-size: 10px;
    font-family: var(--font-mono, monospace);
  }

  figcaption {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 10px;
  }
</style>
