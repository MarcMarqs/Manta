---
import type { TocItem } from '../lib/toc';

interface Props {
  items: TocItem[];
}
const { items } = Astro.props;
---

<nav class="toc" aria-label="On this page">
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.anchor}`}>
            <span class="dash" aria-hidden="true" />
            <span class="label">{item.text}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* The page is centred at --max-width, so the gutter beside it is usually too narrow for
     a readable list of headings: at 1440px it is 170px a side, and labels would sit on
     top of the text. So the resting state is a column of dashes in that gutter — one per
     section, the current one marked — and the labels only appear, over the page and on
     their own panel, while the reader is actually pointing at it. */
  .toc {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    right: max(14px, calc((100vw - var(--max-width)) / 2 - 34px));
    z-index: 15;
    padding: 10px 8px;
    border-radius: var(--radius);
    font-size: 0.82rem;
    line-height: 1.3;
    transition: background 0.18s ease, box-shadow 0.18s ease, right 0.18s ease;
  }

  .toc:hover,
  .toc:focus-within {
    right: max(14px, calc((100vw - var(--max-width)) / 2 - 34px));
    background: var(--surface);
    box-shadow: var(--shadow, 0 8px 30px rgba(0, 0, 0, 0.18));
    border: 1px solid var(--border);
    padding: 10px 14px 10px 8px;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
    text-decoration: none;
    color: var(--muted);
  }

  .dash {
    flex: none;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--border);
    transition: background 0.15s ease, width 0.15s ease;
  }

  .label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.18s ease, opacity 0.18s ease;
  }

  .toc:hover .label,
  .toc:focus-within .label {
    max-width: 15rem;
    opacity: 1;
  }

  .toc a:hover,
  .toc a:focus-visible {
    color: var(--fg);
  }

  .toc a:hover .dash {
    background: var(--fg);
  }

  .toc a.is-current {
    color: var(--accent);
  }

  .toc a.is-current .dash {
    background: var(--accent);
    width: 26px;
  }

  /* Under this width the gutter is gone entirely and the rail would sit on the text. */
  @media (max-width: 1080px) {
    .toc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc,
    .toc .dash,
    .toc .label {
      transition: none;
    }
  }
</style>

<script>
  // Marks the section being read. With several headings on screen an observer is
  // ambiguous, so the rule is simply: the last heading that has crossed the top quarter
  // of the viewport.
  const nav = document.querySelector<HTMLElement>('.toc');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => Boolean(el));

    let pending = false;
    const mark = () => {
      pending = false;
      const line = innerHeight * 0.25;
      let active = 0;
      targets.forEach((target, i) => {
        if (target.getBoundingClientRect().top <= line) active = i;
      });
      // At the very bottom the last section wins, even if its heading is off screen.
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) active = targets.length - 1;
      links.forEach((link, i) => link.classList.toggle('is-current', i === active));
    };

    const onScroll = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(mark);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    // A jump lands without necessarily producing a scroll event of its own.
    addEventListener('hashchange', onScroll);
    mark();
  }
</script>
