---
import type { TocItem } from '../lib/toc';

interface Props {
  items: TocItem[];
}
const { items } = Astro.props;
---

<nav class="toc" aria-label="On this page">
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.anchor}`}>
            <span class="dash" aria-hidden="true" />
            <span class="label">{item.text}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* A list that only appears while it is being pointed at is a list most readers never
     find out about, so it stays open and reads as part of the page.

     Open, it needs about 240px. The page is centred at --max-width, so the gutter beside
     it is narrower than that on most screens and the panel sits over the text rather than
     beside it — hence its own solid surface, and a floor below which it is dropped
     entirely rather than allowed to cover the page it is a map of. */
  .toc {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    right: 20px;
    z-index: 15;
    max-width: 17rem;
    /* A long contents list must not run off the top and bottom of the window. */
    max-height: 76vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow, 0 8px 30px rgba(0, 0, 0, 0.18));
    font-size: 0.82rem;
    line-height: 1.3;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
    text-decoration: none;
    color: var(--muted);
  }

  .dash {
    flex: none;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--border);
    transition: background 0.15s ease, width 0.15s ease;
  }

  .label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc a:hover,
  .toc a:focus-visible {
    color: var(--fg);
  }

  .toc a:hover .dash {
    background: var(--fg);
  }

  .toc a.is-current {
    color: var(--accent);
  }

  .toc a.is-current .dash {
    background: var(--accent);
    width: 26px;
  }

  /* Below this the panel would cover the text column rather than lean on its edge. */
  @media (max-width: 1280px) {
    .toc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc .dash {
      transition: none;
    }
  }
</style>

<script>
  // Marks the section being read. With several headings on screen an observer is
  // ambiguous, so the rule is simply: the last heading that has crossed the top quarter
  // of the viewport.
  const nav = document.querySelector<HTMLElement>('.toc');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => Boolean(el));

    let pending = false;
    const mark = () => {
      pending = false;
      const line = innerHeight * 0.25;
      let active = 0;
      targets.forEach((target, i) => {
        if (target.getBoundingClientRect().top <= line) active = i;
      });
      // At the very bottom the last section wins, even if its heading is off screen.
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) active = targets.length - 1;
      links.forEach((link, i) => link.classList.toggle('is-current', i === active));
    };

    const onScroll = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(mark);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    // A jump lands without necessarily producing a scroll event of its own.
    addEventListener('hashchange', onScroll);
    mark();
  }
</script>
