---
/**
 * Everything inside the page shell: the contents list, the blocks, and the tail a case
 * study carries. Shared so a private case study is the same page as a public one, and
 * can't quietly drift from it — only the way it is reached differs.
 */
import BlockList from './blocks/BlockList.astro';
import Toc from './Toc.astro';
import { originOf, useContent } from '../lib/context';
import { focusPoint } from '../lib/media';
import { headingAnchors, tocItems } from '../lib/toc';
import type { Page, Project } from '../lib/types';

interface Props {
  page: Page;
  /** The project this page is a case study for, if any. */
  project?: Project;
  /** Private work is a dead end on purpose: no tag links out, no next case study. */
  linkOut?: boolean;
}
const { page, project, linkOut = true } = Astro.props;
// Through the context rather than the built content, so the editor's preview shows the
// tail as the draft has it: a cover uploaded but not yet published, a tag just renamed.
const { projects, tags, tagLabel, tagAccent, asset, caseStudy } = useContent(Astro.locals);

/** The one after this, in a given list, wrapping so there is always somewhere to go. */
const after = (list: Project[]) => {
  const index = project ? list.findIndex((p) => p.slug === project.slug) : -1;
  return index >= 0 && list.length > 1 ? list[(index + 1) % list.length] : undefined;
};

// Chosen by hand, kept to one shelf, switched off, or left to follow the Projects order.
const chosen = page.next ? projects.find((p) => p.slug === page.next) : undefined;
const next = !linkOut || !project
  ? undefined
  : chosen
    ? chosen
    : page.next === 'none'
      ? undefined
      : page.next === 'origin'
        ? after(projects.filter((p) => originOf(p.origin, tags.origin) === originOf(project.origin, tags.origin)))
        : after(projects);
const tagsOf = linkOut && project ? [...project.discipline, ...project.engine] : [];

// Headings get anchors either way. Two sections are enough to be worth a list: the home
// page has exactly two — the studio work and the personal studies — and moving between
// them is the whole reason to want one. A page can still opt out in its settings.
const anchors = headingAnchors(page.blocks);
const toc = page.toc === false ? [] : tocItems(page.blocks, anchors);
---

{toc.length >= 2 && <Toc items={toc} />}

<BlockList blocks={page.blocks} anchors={anchors} />

{
  project && project.links.length > 0 && (
    <div class="project-links">
      {project.links.map((link) => (
        <a class="project-link" href={link.href} target="_blank" rel="noopener">
          {link.label}
        </a>
      ))}
    </div>
  )
}

{
  tagsOf.length > 0 && (
    <div class="tag-links" style="margin-top: calc(2rem * var(--spacing))">
      {tagsOf.map((id) => (
        <a class={`tag-chip${tagAccent(id) ? ' is-marked' : ''}`} href={`/tags/${id}`}>
          {tagLabel(id)}
        </a>
      ))}
    </div>
  )
}

{
  next && (
    <a class="next-project" href={caseStudy(next.slug)}>
      {next.cover && (
        <img
          src={asset(next.cover)}
          class={next.coverFit === 'contain' ? 'is-contain' : undefined}
          style={focusPoint(next.coverFocus) && `object-position:${focusPoint(next.coverFocus)}`}
          alt=""
          loading="lazy"
        />
      )}
      <span>
        <span class="eyebrow">Next case study</span>
        <h2>{next.title}</h2>
        <p>{next.summary}</p>
      </span>
    </a>
  )
}
