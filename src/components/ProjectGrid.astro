---
import { useContent } from '../lib/context';
import { srcsetFor } from '../lib/media';
import Filters from './Filters.astro';

interface Props {
  filters?: boolean;
  /** Show only projects carrying this tag id. */
  tag?: string;
}
const { filters = false, tag } = Astro.props;
const { projects: all, tagLabel, asset, preview } = useContent(Astro.locals);
const projects = tag ? all.filter((p) => [...p.discipline, ...p.engine].includes(tag)) : all;
const id = `grid-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="project-grid-wrap" data-grid-root>
  {filters && <Filters scope={id} />}
  <div class="project-grid">
    {
      projects.map((p) => (
        <a
          class="card"
          href={`/work/${p.slug}`}
          data-tags={[...p.discipline, ...p.engine].join(' ')}
        >
          {p.coverVideo ? (
            <video
              src={p.coverVideo}
              poster={asset(p.cover)}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            />
          ) : (
            <img
              src={asset(p.cover)}
              srcset={preview ? undefined : srcsetFor(p.cover)}
              sizes="(max-width: 720px) 92vw, 320px"
              alt=""
              loading="lazy"
            />
          )}
          <div class="card-body">
            <h3>{p.title}</h3>
            <p class="muted card-meta">
              {p.genre} · {p.year}
            </p>
            <p class="card-summary">{p.summary}</p>
            <div class="chips">
              {[...p.discipline, ...p.engine].map((t) => (
                <span class="tag-chip">{tagLabel(t)}</span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* The cover is clipped by the card, so it can grow past its own box. */
  .card img,
  .card video {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    width: 100%;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover img,
  .card:hover video,
  .card:focus-visible img,
  .card:focus-visible video {
    transform: scale(1.045);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card img,
    .card video {
      transition: none;
    }
    .card:hover,
    .card:focus-visible,
    .card:hover img,
    .card:hover video,
    .card:focus-visible img,
    .card:focus-visible video {
      transform: none;
    }
  }
  .card-body {
    padding: 16px;
  }
  .card-body h3 {
    margin-bottom: 2px;
  }
  .card-meta {
    font-size: 0.85rem;
    margin-bottom: 8px;
  }
  .card-summary {
    font-size: 0.95rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .card[hidden] {
    display: none;
  }
</style>

<script>
  import { playWhenVisible, rewind } from '../lib/cover-video';

  // A grid of cover videos all playing at once is a lot of decoding for something
  // nobody is looking at, so each one waits for its card: hover or keyboard focus
  // where there's a pointer, coming into view where there isn't (phones, tablets).
  const stillOnly = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hoverable = matchMedia('(hover: hover)').matches;

  document.querySelectorAll<HTMLElement>('[data-grid-root]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.card')].filter((c) => c.querySelector('video'));
    if (stillOnly || !cards.length) return;

    const play = (card: HTMLElement) => {
      const video = card.querySelector('video');
      if (video) playWhenVisible(video);
    };
    const stop = (card: HTMLElement) => {
      const video = card.querySelector('video');
      if (video) rewind(video);
    };

    if (hoverable) {
      cards.forEach((card) => {
        card.addEventListener('pointerenter', () => play(card));
        card.addEventListener('pointerleave', () => stop(card));
        card.addEventListener('focusin', () => play(card));
        card.addEventListener('focusout', () => stop(card));
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? play : stop)(e.target as HTMLElement)),
      { threshold: 0.6 },
    );
    cards.forEach((card) => observer.observe(card));
  });
</script>
