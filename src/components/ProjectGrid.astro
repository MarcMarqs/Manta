---
import { useContent } from '../lib/context';
import Filters from './Filters.astro';

interface Props {
  filters?: boolean;
  /** Show only projects carrying this tag id. */
  tag?: string;
}
const { filters = false, tag } = Astro.props;
const { projects: all, tagLabel, asset } = useContent(Astro.locals);
const projects = tag ? all.filter((p) => [...p.discipline, ...p.engine].includes(tag)) : all;
const id = `grid-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="project-grid-wrap" data-grid-root>
  {filters && <Filters scope={id} />}
  <div class="project-grid">
    {
      projects.map((p) => (
        <a
          class="card"
          href={`/work/${p.slug}`}
          data-tags={[...p.discipline, ...p.engine].join(' ')}
        >
          {p.coverVideo ? (
            <video
              src={p.coverVideo}
              poster={asset(p.cover)}
              autoplay
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            />
          ) : (
            <img src={asset(p.cover)} alt="" loading="lazy" />
          )}
          <div class="card-body">
            <h3>{p.title}</h3>
            <p class="muted card-meta">
              {p.genre} · {p.year}
            </p>
            <p class="card-summary">{p.summary}</p>
            <div class="chips">
              {[...p.discipline, ...p.engine].map((t) => (
                <span class="tag-chip">{tagLabel(t)}</span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .card img,
  .card video {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    width: 100%;
    display: block;
  }
  .card-body {
    padding: 16px;
  }
  .card-body h3 {
    margin-bottom: 2px;
  }
  .card-meta {
    font-size: 0.85rem;
    margin-bottom: 8px;
  }
  .card-summary {
    font-size: 0.95rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .card[hidden] {
    display: none;
  }
</style>
