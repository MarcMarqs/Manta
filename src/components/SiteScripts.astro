---
// Two small site-wide behaviours: blocks fading in as they scroll into view, and
// images opening full size. Both are inert when the visitor asks for reduced motion,
// and both no-op inside the editor preview, which has its own click handling.
---

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const inEditor = Boolean(document.querySelector('.pv-block'));

  // --- reveal on scroll ---------------------------------------------------

  if (!calm && !inEditor && 'IntersectionObserver' in window) {
    const blocks = document.querySelectorAll<HTMLElement>('main .blocks > *');
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          watcher.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    blocks.forEach((block, i) => {
      // What's already on screen at load shouldn't animate in late.
      if (block.getBoundingClientRect().top < innerHeight * 0.9 && i < 3) {
        block.classList.add('is-revealed');
        return;
      }
      block.classList.add('will-reveal');
      watcher.observe(block);
    });
  }

  // --- lightbox -----------------------------------------------------------

  if (!inEditor) {
    const selector = 'figure img, .gallery img';
    let items: HTMLImageElement[] = [];
    let index = 0;

    const box = document.createElement('div');
    box.className = 'lightbox';
    box.hidden = true;
    box.innerHTML = `
      <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
      <button class="lightbox-nav prev" type="button" aria-label="Previous image">&#8249;</button>
      <figure><img alt=""><figcaption></figcaption></figure>
      <button class="lightbox-nav next" type="button" aria-label="Next image">&#8250;</button>`;
    document.body.appendChild(box);

    const picture = box.querySelector('img')!;
    const caption = box.querySelector('figcaption')!;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      picture.src = item.currentSrc || item.src;
      picture.alt = item.alt;
      const text = item.closest('figure')?.querySelector('figcaption')?.textContent ?? item.alt;
      caption.textContent = text ?? '';
      caption.hidden = !text;
      box.querySelectorAll('.lightbox-nav').forEach((b) => ((b as HTMLElement).hidden = items.length < 2));
    };

    const open = (target: HTMLImageElement) => {
      // A gallery browses within itself; a lone image opens on its own.
      const gallery = target.closest('.gallery');
      items = gallery
        ? [...gallery.querySelectorAll<HTMLImageElement>('img')]
        : [target];
      show(items.indexOf(target));
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      (box.querySelector('.lightbox-close') as HTMLElement).focus();
    };

    const close = () => {
      box.hidden = true;
      picture.removeAttribute('src');
      document.body.style.overflow = '';
    };

    document.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLImageElement>(selector);
      // Images that are themselves links keep being links.
      if (!target || target.closest('a')) return;
      event.preventDefault();
      open(target);
    });

    box.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      if (el.classList.contains('next')) show(index + 1);
      else if (el.classList.contains('prev')) show(index - 1);
      else if (!el.closest('figure') || el.classList.contains('lightbox-close')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (box.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowRight') show(index + 1);
      if (event.key === 'ArrowLeft') show(index - 1);
    });
  }
</script>
