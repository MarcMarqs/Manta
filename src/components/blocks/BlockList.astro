---
import type { Block as BlockData } from '../../lib/types';
import Block from './Block.astro';

interface Props {
  blocks: BlockData[];
  /** Heading anchors for the page, keyed by block id. Absent in the editor preview. */
  anchors?: Map<string, string>;
}
const { blocks, anchors } = Astro.props;
---

<div class="blocks">
  {blocks.map((block) => <Block block={block} anchors={anchors} />)}
</div>
