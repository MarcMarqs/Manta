---
import type { Block } from '../../lib/types';
import { useContent } from '../../lib/context';
import { srcsetFor } from '../../lib/media';
import Chart from '../Chart.astro';
import ProjectRail from '../ProjectRail.astro';
import ProjectGrid from '../ProjectGrid.astro';
// Self-import: `section` and `columns` hold nested blocks.
import Self from './Block.astro';

interface Props {
  block: Block;
  /** Heading anchors for the whole page, keyed by block id; see lib/toc.ts. */
  anchors?: Map<string, string>;
}
const { block, anchors } = Astro.props;
const { preview, asset } = useContent(Astro.locals);

// Blocks with a width or alignment get a wrapper carrying those classes (styled in
// global.css). "content" is the old image-only name for normal width.
const width = (block.width as string) === 'content' ? 'normal' : (block.width ?? 'normal');
const layout = [width !== 'normal' && `w-${width}`, block.align && block.align !== 'left' && `a-${block.align}`]
  .filter(Boolean)
  .join(' ');

// In the editor preview every block is also wrapped and tagged with its id, so a click in
// the preview can select the matching block in the editor. Plain blocks on the built
// site get no wrapper at all.
const Wrap = preview || layout ? 'div' : Fragment;
const wrapProps =
  preview || layout
    ? {
        class: ['blk', layout, preview && 'pv-block'].filter(Boolean).join(' '),
        ...(preview ? { 'data-block-id': block.id, 'data-block-type': block.type } : {}),
      }
    : {};

// Per-image size: a width percentage and an optional crop shape.
const imageStyle = (b: Extract<Block, { type: 'image' }>) =>
  [
    b.scale && b.scale !== 100 ? `width:${b.scale}%` : '',
    b.aspect && b.aspect !== 'auto' ? `aspect-ratio:${b.aspect.replace(':', '/')};object-fit:cover` : '',
  ]
    .filter(Boolean)
    .join(';') || undefined;

const embedSrc = (b: Extract<Block, { type: 'video' }>) =>
  ({
    youtube: `https://www.youtube-nocookie.com/embed/${b.videoId}`,
    vimeo: `https://player.vimeo.com/video/${b.videoId}`,
    itch: `https://itch.io/embed/${b.videoId}`,
  })[b.provider];
---

<Wrap {...wrapProps}>
  {
    block.type === 'heading' && (
      <Fragment
        set:html={`<h${block.level}${anchors?.get(block.id) ? ` id="${anchors.get(block.id)}"` : ''}>${block.text}</h${block.level}>`}
      />
    )
  }

  {block.type === 'text' && <div class="rich" set:html={block.html} />}

  {
    block.type === 'image' && (
      <figure>
        <img
          src={asset(block.src)}
          srcset={preview ? undefined : srcsetFor(block.src)}
          sizes="(max-width: 760px) 92vw, 760px"
          alt={block.alt}
          loading="lazy"
          style={imageStyle(block)}
        />
        {block.caption && <figcaption>{block.caption}</figcaption>}
      </figure>
    )
  }

  {
    block.type === 'gallery' && (
      <div class="gallery">
        {block.images.map((img) => (
          <img
            src={asset(img.src)}
            srcset={preview ? undefined : srcsetFor(img.src)}
            sizes="(max-width: 720px) 45vw, 260px"
            alt={img.alt}
            loading="lazy"
          />
        ))}
      </div>
    )
  }

  {
    block.type === 'video' && (
      <div class="embed">
        <iframe
          src={embedSrc(block)}
          title={block.title ?? 'Embedded video'}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
          allowfullscreen
        />
      </div>
    )
  }

  {
    block.type === 'button' && (
      <p>
        <a class={`btn btn-${block.style ?? 'primary'}`} href={block.href}>
          {block.label}
        </a>
      </p>
    )
  }

  {block.type === 'divider' && <hr class="block-divider" />}

  {block.type === 'spacer' && <div class={`spacer spacer-${block.size ?? 'md'}`} />}

  {
    block.type === 'table' && (
      <figure class="table-wrap">
        <table>
          <thead>
            <tr>
              {block.columns.map((c) => (
                <th scope="col">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {block.rows.map((row) => (
              <tr>
                {row.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        {block.caption && <figcaption>{block.caption}</figcaption>}
      </figure>
    )
  }

  {
    block.type === 'specs' && (
      <dl class="specs">
        {block.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    block.type === 'stats' && (
      <div class="stats">
        {block.items.map((item) => (
          <div>
            <span class="stat-value">{item.value}</span>
            <span class="stat-label">{item.label}</span>
          </div>
        ))}
      </div>
    )
  }

  {
    block.type === 'chart' && (
      <Chart variant={block.variant} title={block.title} series={block.series} />
    )
  }

  {
    block.type === 'columns' && (
      <div class="columns" style={`--cols:${block.count}`}>
        {block.columns.map((col) => (
          <div class="column blocks">
            {col.blocks.map((child) => (
              <Self block={child} anchors={anchors} />
            ))}
          </div>
        ))}
      </div>
    )
  }

  {
    block.type === 'section' && (
      <section class={`section bg-${block.background ?? 'none'}`}>
        <div class={`blocks${block.arrange === 'row' ? ' as-row' : ''}`}>
          {block.blocks.map((child) => (
            <Self block={child} anchors={anchors} />
          ))}
        </div>
      </section>
    )
  }

  {block.type === 'projectRail' && <ProjectRail filters={block.filters} origin={block.origin} />}

  {block.type === 'projectGrid' && <ProjectGrid filters={block.filters} origin={block.origin} />}

  {block.type === 'html' && <div class="raw-html" set:html={block.html} />}
</Wrap>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 720px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
  .section {
    border-radius: var(--radius);
  }
  /* Side by side, wrapping rather than shrinking, so a row of buttons becomes two rows
     on a phone instead of a line of squeezed labels. The margin rule that separates
     stacked blocks would fight the gap, so it is cancelled here. */
  .blocks.as-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(0.9rem * var(--spacing));
  }
  .blocks.as-row > * + * {
    margin-top: 0;
  }
  /* In a row a block is as wide as it needs to be; the width choices describe a column
     of content and have nothing to say here. */
  .blocks.as-row > .blk {
    width: auto;
    max-width: 100%;
  }
  .section.bg-surface,
  .section.bg-accent {
    padding: calc(28px * var(--spacing));
  }
  .section.bg-surface {
    background: var(--surface);
  }
  .section.bg-accent {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg));
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .gallery img {
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }
  figure img {
    border-radius: var(--radius);
  }
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius);
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
  }
  th,
  td {
    text-align: left;
    padding: 9px 14px;
    border-bottom: 1px solid var(--border);
  }
  th {
    font-family: var(--font-heading);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  /* A row of small label/value pairs. Wraps rather than scrolls, because on a phone five
     of these should stack into a readable list, not a sideways table. */
  .specs {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .specs dt {
    font-family: var(--font-heading);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .specs dd {
    margin: 0;
    font-weight: 500;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 18px;
    padding: 4px 0;
  }

  .stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 1.2rem + 2vw, 2.9rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--accent);
  }

  .stat-label {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 560px) {
    .specs {
      gap: 14px 28px;
    }
  }

  .spacer-sm {
    height: 16px;
  }
  .spacer-md {
    height: 40px;
  }
  .spacer-lg {
    height: 80px;
  }
  .rich :global(ul),
  .rich :global(ol) {
    padding-left: 20px;
  }
  .rich :global(:last-child) {
    margin-bottom: 0;
  }
</style>
