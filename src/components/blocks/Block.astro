---
import type { Block } from '../../lib/types';
import { useContent } from '../../lib/context';
import { srcsetFor } from '../../lib/media';
import Chart from '../Chart.astro';
import Flow from '../Flow.astro';
import Radar from '../Radar.astro';
import SystemMap from '../SystemMap.astro';
import Tornado from '../Tornado.astro';
import ProjectRail from '../ProjectRail.astro';
import ProjectGrid from '../ProjectGrid.astro';
// Self-import: `section` and `columns` hold nested blocks.
import Self from './Block.astro';

interface Props {
  block: Block;
  /** Heading anchors for the whole page, keyed by block id; see lib/toc.ts. */
  anchors?: Map<string, string>;
}
const { block, anchors } = Astro.props;
const { preview, asset } = useContent(Astro.locals);

// Blocks with a width or alignment get a wrapper carrying those classes (styled in
// global.css). "content" is the old image-only name for normal width.
const width = (block.width as string) === 'content' ? 'normal' : (block.width ?? 'normal');
const layout = [width !== 'normal' && `w-${width}`, block.align && block.align !== 'left' && `a-${block.align}`]
  .filter(Boolean)
  .join(' ');

// In the editor preview every block is also wrapped and tagged with its id, so a click in
// the preview can select the matching block in the editor. Plain blocks on the built
// site get no wrapper at all.
const Wrap = preview || layout ? 'div' : Fragment;
const wrapProps =
  preview || layout
    ? {
        class: ['blk', layout, preview && 'pv-block'].filter(Boolean).join(' '),
        ...(preview ? { 'data-block-id': block.id, 'data-block-type': block.type } : {}),
      }
    : {};

// Per-image size: a width percentage and an optional crop shape.
const imageStyle = (b: Extract<Block, { type: 'image' }>) =>
  [
    b.scale && b.scale !== 100 ? `width:${b.scale}%` : '',
    b.aspect && b.aspect !== 'auto' ? `aspect-ratio:${b.aspect.replace(':', '/')};object-fit:cover` : '',
  ]
    .filter(Boolean)
    .join(';') || undefined;

/**
 * The address a spreadsheet is embedded from.
 *
 * Both ids are scrubbed down to the characters Google actually uses, because whatever
 * was typed into the editor ends up inside this URL: without it a pasted string could
 * carry its own query or climb out of the path.
 */
const sheetSrc = (b: Extract<Block, { type: 'sheet' }>) => {
  const id = b.sheetId.replace(/[^\w-]/g, '');
  const gid = (b.gid ?? '').replace(/\D/g, '');
  if (b.source === 'published') {
    const params = new URLSearchParams({ single: 'true', widget: 'true', headers: 'false' });
    if (gid) params.set('gid', gid);
    return `https://docs.google.com/spreadsheets/d/e/${id}/pubhtml?${params}`;
  }
  // The tab goes in the fragment, not the query. /preview reads location.hash to pick
  // which sheet to load and ignores ?gid= entirely, so a query there silently lands the
  // reader on the first tab however carefully the gid was set.
  return `https://docs.google.com/spreadsheets/d/${id}/preview${gid ? `#gid=${gid}` : ''}`;
};

/** The address a document is embedded from. Scrubbed for the same reason as a sheet. */
const docSrc = (b: Extract<Block, { type: 'doc' }>) => {
  const id = b.docId.replace(/[^\w-]/g, '');
  return b.source === 'published'
    ? `https://docs.google.com/document/d/e/${id}/pub?embedded=true`
    : `https://docs.google.com/document/d/${id}/preview`;
};

const embedSrc = (b: Extract<Block, { type: 'video' }>) =>
  ({
    youtube: `https://www.youtube-nocookie.com/embed/${b.videoId}`,
    vimeo: `https://player.vimeo.com/video/${b.videoId}`,
    itch: `https://itch.io/embed/${b.videoId}`,
  })[b.provider];
---

<Wrap {...wrapProps}>
  {
    block.type === 'heading' &&
      (block.number || block.eyebrow ? (
        <div class="section-header">
          <p class="section-kicker">
            {block.number && <span class="section-number">{block.number}</span>}
            {block.eyebrow}
          </p>
          <Fragment
            set:html={`<h${block.level}${anchors?.get(block.id) ? ` id="${anchors.get(block.id)}"` : ''}>${block.text}</h${block.level}>`}
          />
        </div>
      ) : (
        <Fragment
          set:html={`<h${block.level}${anchors?.get(block.id) ? ` id="${anchors.get(block.id)}"` : ''}>${block.text}</h${block.level}>`}
        />
      ))
  }

  {
    block.type === 'text' && (
      <div
        class={`rich leading-${block.leading ?? 'normal'} gap-${block.gap ?? 'normal'}`}
        set:html={block.html}
      />
    )
  }

  {
    block.type === 'image' && (
      <figure>
        <img
          src={asset(block.src)}
          srcset={preview ? undefined : srcsetFor(block.src)}
          sizes="(max-width: 760px) 92vw, 760px"
          alt={block.alt}
          loading="lazy"
          style={imageStyle(block)}
        />
        {block.caption && <figcaption>{block.caption}</figcaption>}
      </figure>
    )
  }

  {
    block.type === 'gallery' &&
      (block.layout === 'carousel' ? (
        /* The track scrolls and snaps, so a touch screen swipes it and a keyboard can
           tab to it, with or without the buttons. The buttons only nudge that scroll. */
        <div class="carousel" data-carousel>
          <div class="carousel-track" tabindex="0" aria-label="Images, scrollable">
            {block.images.map((img) => (
              <figure class="carousel-slide">
                <img
                  src={asset(img.src)}
                  srcset={preview ? undefined : srcsetFor(img.src)}
                  sizes="(max-width: 900px) 92vw, 760px"
                  alt={img.alt}
                  loading="lazy"
                />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            ))}
          </div>
          {block.images.length > 1 && (
            <>
              <button type="button" class="carousel-arrow prev" data-step="-1" aria-label="Previous image">
                &#8249;
              </button>
              <button type="button" class="carousel-arrow next" data-step="1" aria-label="Next image">
                &#8250;
              </button>
              <div class="carousel-dots" role="tablist" aria-label="Choose an image">
                {block.images.map((_, i) => (
                  <button type="button" class="carousel-dot" data-to={i} aria-label={`Image ${i + 1}`} />
                ))}
              </div>
            </>
          )}
        </div>
      ) : (
        <div class="gallery">
          {block.images.map((img) => (
            <img
              src={asset(img.src)}
              srcset={preview ? undefined : srcsetFor(img.src)}
              sizes="(max-width: 720px) 45vw, 260px"
              alt={img.alt}
              loading="lazy"
            />
          ))}
        </div>
      ))
  }

  {
    block.type === 'video' && (
      <div class="embed">
        <iframe
          src={embedSrc(block)}
          title={block.title ?? 'Embedded video'}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
          allowfullscreen
        />
      </div>
    )
  }

  {
    block.type === 'button' && (
      <p>
        <a
          class={`btn btn-${block.style ?? 'primary'}`}
          href={block.href}
          target={/^https?:/i.test(block.href) ? '_blank' : undefined}
          rel={/^https?:/i.test(block.href) ? 'noopener' : undefined}
        >
          {block.label}
        </a>
      </p>
    )
  }

  {
    block.type === 'sheet' &&
      (block.sheetId ? (
        <figure class={`sheet sheet-${block.height ?? 'medium'}`}>
          <iframe src={sheetSrc(block)} title={block.title ?? 'Embedded spreadsheet'} loading="lazy" />
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      ) : (
        preview && <p class="blk-empty">Paste a Google Sheets link to show it here.</p>
      ))
  }

  {
    block.type === 'doc' &&
      (block.docId ? (
        <figure class={`sheet sheet-${block.height ?? 'medium'}`}>
          <iframe src={docSrc(block)} title={block.title ?? 'Embedded document'} loading="lazy" />
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      ) : (
        preview && <p class="blk-empty">Paste a Google Docs link to show it here.</p>
      ))
  }

  {block.type === 'divider' && <hr class="block-divider" />}

  {block.type === 'spacer' && <div class={`spacer spacer-${block.size ?? 'md'}`} />}

  {
    block.type === 'table' && (
      <figure class="table-wrap">
        <table>
          <thead>
            <tr>
              {block.columns.map((c) => (
                <th scope="col">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {block.rows.map((row) => (
              <tr>
                {row.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        {block.caption && <figcaption>{block.caption}</figcaption>}
      </figure>
    )
  }

  {
    block.type === 'specs' && (
      <dl class="specs">
        {block.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    block.type === 'stats' && (
      <div class="stats">
        {block.items.map((item) => (
          <div>
            <span class="stat-value">{item.value}</span>
            <span class="stat-label">{item.label}</span>
          </div>
        ))}
      </div>
    )
  }

  {
    block.type === 'pillars' && (
      <div class="pillars">
        {block.items.map((item) => (
          <div class="pillar">
            <p class="pillar-label">{item.label}</p>
            <p class="pillar-body">{item.body}</p>
          </div>
        ))}
      </div>
    )
  }

  {
    block.type === 'tornado' && (
      <Tornado
        title={block.title}
        unit={block.unit}
        lowLabel={block.lowLabel}
        highLabel={block.highLabel}
        rows={block.rows}
      />
    )
  }

  {block.type === 'flow' && <Flow caption={block.caption} nodes={block.nodes} edges={block.edges} />}

  {
    block.type === 'systemMap' && (
      <SystemMap arrange={block.arrange} caption={block.caption} nodes={block.nodes} links={block.links} />
    )
  }

  {block.type === 'radar' && <Radar title={block.title} axes={block.axes} max={block.max} series={block.series} />}

  {
    block.type === 'chart' && (
      <Chart
        variant={block.variant}
        direction={block.direction}
        title={block.title}
        note={block.note}
        range={block.range}
        reference={block.reference}
        series={block.series}
      />
    )
  }

  {
    block.type === 'columns' && (
      <div class="columns" style={`--cols:${block.count}`}>
        {block.columns.map((col) => (
          <div class="column blocks">
            {col.blocks.map((child) => (
              <Self block={child} anchors={anchors} />
            ))}
          </div>
        ))}
      </div>
    )
  }

  {
    block.type === 'section' && (
      <section class={`section bg-${block.background ?? 'none'}`}>
        <div class={`blocks${block.arrange === 'row' ? ' as-row' : ''}`}>
          {block.blocks.map((child) => (
            <Self block={child} anchors={anchors} />
          ))}
        </div>
      </section>
    )
  }

  {block.type === 'projectRail' && <ProjectRail filters={block.filters} origin={block.origin} />}

  {block.type === 'projectGrid' && <ProjectGrid filters={block.filters} origin={block.origin} />}

  {block.type === 'html' && <div class="raw-html" set:html={block.html} />}
</Wrap>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 720px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
  .section {
    border-radius: var(--radius);
  }
  /* Side by side, wrapping rather than shrinking, so a row of buttons becomes two rows
     on a phone instead of a line of squeezed labels. The margin rule that separates
     stacked blocks would fight the gap, so it is cancelled here. */
  .blocks.as-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(0.9rem * var(--spacing));
  }
  .blocks.as-row > * + * {
    margin-top: 0;
  }
  /* In a row a block is as wide as it needs to be; the width choices describe a column
     of content and have nothing to say here. */
  .blocks.as-row > .blk {
    width: auto;
    max-width: 100%;
  }
  .section.bg-surface,
  .section.bg-accent {
    padding: calc(28px * var(--spacing));
  }
  .section.bg-surface {
    background: var(--surface);
  }
  .section.bg-accent {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg));
  }
  /* Flex rather than grid: with `auto-fit` a trailing row holding fewer boxes than the
     column count leaves a visible empty track, where flex lets a lone last box stretch
     across the space instead. */
  .pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .pillar {
    flex: 1 1 200px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .pillar-label {
    font-family: var(--font-heading);
    font-weight: 600;
    margin: 0 0 4px;
  }

  .pillar-body {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .section-header :global(h1),
  .section-header :global(h2),
  .section-header :global(h3),
  .section-header :global(h4) {
    margin-top: 0;
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 2px;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .section-number {
    color: var(--accent);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .gallery img {
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  /* One image at a time. The track is a scroller with snap points rather than a
     transform, so swiping works on its own and the arrows have only to scroll it. */
  .carousel {
    position: relative;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 0;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    margin: 0;
  }

  .carousel-slide img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
    cursor: zoom-in;
  }

  .carousel-slide figcaption {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 8px;
  }

  .carousel-arrow {
    position: absolute;
    top: calc(50% - 20px);
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--fg);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    backdrop-filter: blur(4px);
  }
  .carousel-arrow.prev {
    left: 10px;
  }
  .carousel-arrow.next {
    right: 10px;
  }
  .carousel-arrow:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .carousel-arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
  }

  .carousel-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
  }
  .carousel-dot[aria-selected='true'] {
    background: var(--accent);
    width: 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      scroll-behavior: auto;
    }
  }
  figure img {
    border-radius: var(--radius);
  }
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius);
  }
  /* The sheet keeps its own chrome, so the frame here is only a border to sit it on.
     A fixed height rather than an aspect ratio: how tall a spreadsheet wants to be has
     to do with how many rows matter, not with how wide the page is. */
  .sheet {
    margin: 0;
  }
  /* Only ever seen in the editor's preview, so an unfilled block still has something to
     click on instead of disappearing. */
  .blk-empty {
    margin: 0;
    padding: 18px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .sheet iframe {
    width: 100%;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    display: block;
  }
  .sheet-short iframe {
    height: 320px;
  }
  .sheet-medium iframe {
    height: 480px;
  }
  .sheet-tall iframe {
    height: 720px;
  }
  .sheet figcaption {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
  }
  th,
  td {
    text-align: left;
    padding: 9px 14px;
    border-bottom: 1px solid var(--border);
  }
  th {
    font-family: var(--font-heading);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  /* A row of small label/value pairs. Wraps rather than scrolls, because on a phone five
     of these should stack into a readable list, not a sideways table. */
  .specs {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .specs dt {
    font-family: var(--font-heading);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .specs dd {
    margin: 0;
    font-weight: 500;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 18px;
    padding: 4px 0;
  }

  .stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 1.2rem + 2vw, 2.9rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--accent);
  }

  .stat-label {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 560px) {
    .specs {
      gap: 14px 28px;
    }
  }

  .spacer-sm {
    height: 16px;
  }
  .spacer-md {
    height: 40px;
  }
  .spacer-lg {
    height: 80px;
  }
  .rich :global(ul),
  .rich :global(ol) {
    padding-left: 20px;
  }
  .rich :global(:last-child) {
    margin-bottom: 0;
  }

  /* Highlighted text. A tint of the accent rather than a yellow felt-tip, so it belongs
     to the page; the padding is asymmetric because text sits off-centre in its line box. */
  .rich :global(mark) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: inherit;
    padding: 0.1em 0.2em 0.02em;
  }

  /* A raised passage: the line it sits in has to grow with it, or it crowds the line above. */
  .rich :global(.big) {
    font-size: 1.18em;
    line-height: 1.45;
  }

  .rich.leading-tight {
    line-height: 1.4;
  }
  .rich.leading-airy {
    line-height: 1.9;
  }

  .rich.gap-tight :global(:is(p, ul, ol)) {
    margin-bottom: 0.6em;
  }
  .rich.gap-airy :global(:is(p, ul, ol)) {
    margin-bottom: 1.6em;
  }
  /* Set last, because the spacing rules above out-specify the plain one. */
  .rich.gap-tight :global(:last-child),
  .rich.gap-airy :global(:last-child) {
    margin-bottom: 0;
  }
</style>
