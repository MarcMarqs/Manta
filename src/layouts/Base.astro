---
import { legibleOn, onColor } from '../lib/color';
import { useContent } from '../lib/context';
import { fontStack, googleFontsHref } from '../lib/fonts';
import SiteScripts from '../components/SiteScripts.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  /** Picture for link previews, as a site path or a full URL. */
  image?: string;
  /** Keep this page out of search results and out of link previews. */
  noindex?: boolean;
}

const { title, description, path, image, noindex } = Astro.props;
const { site, preview } = useContent(Astro.locals);
const t = site.theme;
const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const fontsHref = googleFontsHref([t.fontHeading, t.fontBody, t.fontMono]);

/**
 * One accent per theme.
 *
 * The same hex cannot serve both: this site's green measures 13.5:1 on the dark
 * background and 1.3:1 on white, where it is a stain rather than a colour. So the dark
 * theme takes its own, and when none is set one is derived that can actually be read
 * there. The text that sits on top of a filled accent is derived too, because a button
 * that hardcoded white only worked while the accent stayed dark.
 */
const accentLight = t.accent;
const accentDark = t.accentDark || legibleOn(t.accent, t.bgDark);

// Chat apps and search engines need absolute URLs, which only site.url can give.
const base = site.url?.replace(/\/$/, '');
const absolute = (value?: string) =>
  !value ? undefined : /^https?:\/\//.test(value) ? value : base ? `${base}${value}` : undefined;
const canonical = base && path ? `${base}${path === '/' ? '/' : path}` : undefined;
const shareImage = absolute(image || site.socialImage);
const shareText = description || site.tagline;

// Not in the editor's preview: looking at your own page while writing it is not a visit,
// and counting it would make the numbers answer the wrong question.
const beacon = !preview && site.analyticsToken ? site.analyticsToken : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* A crawler that reaches a private page anyway is told to forget it. */}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {!noindex && canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    {shareText && <meta property="og:description" content={shareText} />}
    {!noindex && canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    {shareText && <meta name="twitter:description" content={shareText} />}
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      fontsHref && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fontsHref} />
        </>
      )
    }
    <style is:inline set:html={`:root{
      --accent:${accentLight}; --accent-fg:${onColor(accentLight)};
      --bg:${t.bg}; --fg:${t.fg}; --muted:${t.muted};
      --surface:${t.surface}; --border:${t.border};
      --font-heading:${fontStack(t.fontHeading)}; --font-body:${fontStack(t.fontBody)};
      --font-mono:${fontStack(t.fontMono)};
      --radius:${t.radius}; --max-width:${t.maxWidth}; --spacing:${t.spacing};
    }
    :root[data-theme="dark"]{
      --accent:${accentDark}; --accent-fg:${onColor(accentDark)};
      --bg:${t.bgDark}; --fg:${t.fgDark}; --muted:${t.mutedDark};
      --surface:${t.surfaceDark}; --border:${t.borderDark};
    }
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]){
        --accent:${accentDark}; --accent-fg:${onColor(accentDark)};
        --bg:${t.bgDark}; --fg:${t.fgDark}; --muted:${t.mutedDark};
        --surface:${t.surfaceDark}; --border:${t.borderDark};
      }
    }`} />
    <script is:inline>
      // Applied before paint so a remembered theme never flashes the wrong colors.
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav>
          {
            site.nav.map((item) => (
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
          Theme
        </button>
      </div>
    </header>


    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <SiteScripts />

    <footer class="site-footer">
      <div class="wrap">
        <nav class="footer-nav" aria-label="Sections">
          {
            site.nav.map((item) => (
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <p class="footer-note">{site.footer}</p>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>

    {
      beacon && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
  </body>
</html>
