---
import { useContent } from '../lib/context';
import { fontStack, googleFontsHref } from '../lib/fonts';
import SiteScripts from '../components/SiteScripts.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  /** Picture for link previews, as a site path or a full URL. */
  image?: string;
}

const { title, description, path, image } = Astro.props;
const { site } = useContent(Astro.locals);
const t = site.theme;
const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const fontsHref = googleFontsHref([t.fontHeading, t.fontBody, t.fontMono]);

/**
 * What colour text sits on the accent.
 *
 * A filled button used to hardcode white, which only works while the accent is dark:
 * against this site's own accent it measured 3.1:1, under the 4.5:1 a reader needs.
 * The accent is content — anyone can change it in Site & theme — so the foreground is
 * derived from it rather than assumed.
 */
function onAccent(hex: string): string {
  const m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(hex.trim());
  if (!m) return '#ffffff';
  const full = m[1].length === 3 ? m[1].replace(/./g, (c) => c + c) : m[1];
  const channel = (i: number) => {
    const v = parseInt(full.slice(i * 2, i * 2 + 2), 16) / 255;
    return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
  };
  const luminance = 0.2126 * channel(0) + 0.7152 * channel(1) + 0.0722 * channel(2);
  const onWhite = 1.05 / (luminance + 0.05);
  const onBlack = (luminance + 0.05) / 0.05;
  return onWhite >= onBlack ? '#ffffff' : '#10131a';
}

const accentFg = onAccent(t.accent);

// Chat apps and search engines need absolute URLs, which only site.url can give.
const base = site.url?.replace(/\/$/, '');
const absolute = (value?: string) =>
  !value ? undefined : /^https?:\/\//.test(value) ? value : base ? `${base}${value}` : undefined;
const canonical = base && path ? `${base}${path === '/' ? '/' : path}` : undefined;
const shareImage = absolute(image || site.socialImage);
const shareText = description || site.tagline;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    {shareText && <meta property="og:description" content={shareText} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    {shareText && <meta name="twitter:description" content={shareText} />}
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      fontsHref && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fontsHref} />
        </>
      )
    }
    <style is:inline set:html={`:root{
      --accent:${t.accent}; --accent-fg:${accentFg};
      --bg:${t.bg}; --fg:${t.fg}; --muted:${t.muted};
      --surface:${t.surface}; --border:${t.border};
      --font-heading:${fontStack(t.fontHeading)}; --font-body:${fontStack(t.fontBody)};
      --font-mono:${fontStack(t.fontMono)};
      --radius:${t.radius}; --max-width:${t.maxWidth}; --spacing:${t.spacing};
    }
    :root[data-theme="dark"]{
      --bg:${t.bgDark}; --fg:${t.fgDark}; --muted:${t.mutedDark};
      --surface:${t.surfaceDark}; --border:${t.borderDark};
    }
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]){
        --bg:${t.bgDark}; --fg:${t.fgDark}; --muted:${t.mutedDark};
        --surface:${t.surfaceDark}; --border:${t.borderDark};
      }
    }`} />
    <script is:inline>
      // Applied before paint so a remembered theme never flashes the wrong colors.
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav>
          {
            site.nav.map((item) => (
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
          Theme
        </button>
      </div>
    </header>


    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <SiteScripts />

    <footer class="site-footer">
      <div class="wrap">
        <nav class="footer-nav" aria-label="Sections">
          {
            site.nav.map((item) => (
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <p class="footer-note">{site.footer}</p>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
