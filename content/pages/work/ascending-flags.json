    },
    {
      "id": "depth",
      "type": "pillars",
      "items": [
        {
          "label": "Imperfect information",
          "body": "Concealed enemy flag positions and base parameters, which raises the strategic value of scouting and makes bluffing worth doing."
        },
        {
          "label": "Variance mitigation",
          "body": "Excess terrain cards convert into usable mana once the board is saturated, eliminating late-game dead draws."
        },
        {
          "label": "Asymmetric border placement",
          "body": "Hidden flag deployment along personalised territory boundaries, so opponents have to deduce coordinates from movement cues."
        }
      ]
    },
    {
      "id": "d3",
