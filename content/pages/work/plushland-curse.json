      "items": [
        {
          "label": "AI behaviour",
          "body": "Designed the AI for distinct enemy archetypes, each with its own actions, movement and weapon use."
        },
        {
          "label": "Weapon system",
          "body": "Architected the multi-tier weapon taxonomy: combat mechanics, damage types, and an interdependent rock-paper-scissors counter matrix."
        },
        {
          "label": "Gameplay systems",
          "body": "Built the core systems behind combat, enemies and the economy."
        },
        {
          "label": "Balancing",
          "body": "Formulated damage calculators and a hit-to-kill matrix in spreadsheets to simulate exact strike thresholds per archetype, giving predictable progression curves and systemic combat equity."
        }
      ]
